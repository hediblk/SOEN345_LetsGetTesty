# E2E customer login (copy to gitignored `.env`)
#   cp .env.example .env
# Then edit `.env` with your credentials — do not commit `.env`.
#
# If unset, Playwright tests fall back to seed user from database/init.sql (user1@example.com / user123).

E2E_USER_EMAIL=
# Quote the value if it contains #, !, spaces, etc.
E2E_USER_PASSWORD=
